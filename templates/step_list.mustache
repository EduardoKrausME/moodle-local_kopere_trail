{{!
    @template local_kopere_trail/step_list

    Example context (json):
    {}
}}

<div class="kopere-trail kopere-trail-steps-admin">
    <div class="kopere-trail__topbar">
        <div>
            <a class="kopere-trail-back" href="{{manageurl}}">{{#str}}backtomanage, local_kopere_trail{{/str}}</a>
            <h2>{{trailname}}</h2>
        </div>
        <div class="kopere-trail-actions">
            <a class="btn btn-outline-secondary" href="{{edgesurl}}">{{#str}}trailedges, local_kopere_trail{{/str}}</a>
            <a class="btn btn-primary" href="{{createurl}}">{{#str}}createstep, local_kopere_trail{{/str}}</a>
        </div>
    </div>

    {{#hassteps}}
        <div class="table-responsive">
            <table class="table kopere-trail-table">
                <thead>
                    <tr>
                        <th>{{#str}}name, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}contenttype, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}completiontype, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}optional, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}visible, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}actions, local_kopere_trail{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#steps}}
                        <tr>
                            <td>{{name}}</td>
                            <td>{{contenttype}}</td>
                            <td>{{completiontype}}</td>
                            <td>{{#optional}}{{#str}}yes{{/str}}{{/optional}}{{^optional}}{{#str}}no{{/str}}{{/optional}}</td>
                            <td>{{visiblelabel}}</td>
                            <td class="kopere-trail-actions">
                                <a class="btn btn-sm btn-outline-secondary" href="{{moveupurl}}" title="{{#str}}moveup, local_kopere_trail{{/str}}">↑</a>
                                <a class="btn btn-sm btn-outline-secondary" href="{{movedownurl}}" title="{{#str}}movedown, local_kopere_trail{{/str}}">↓</a>
                                <a class="btn btn-sm btn-outline-primary" href="{{editurl}}">{{#str}}edit, local_kopere_trail{{/str}}</a>
                            </td>
                        </tr>
                    {{/steps}}
                </tbody>
            </table>
        </div>
    {{/hassteps}}

    {{^hassteps}}
        <div class="kopere-trail-empty">
            <p>{{#str}}nosteps, local_kopere_trail{{/str}}</p>
        </div>
    {{/hassteps}}
</div>
