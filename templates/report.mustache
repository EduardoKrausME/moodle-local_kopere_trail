{{!
    @template local_kopere_trail/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<div class="kopere-trail kopere-trail-report">
    <div class="kopere-trail__topbar">
        <div>
            <a class="kopere-trail-back" href="{{manageurl}}">{{#str}}backtomanage, local_kopere_trail{{/str}}</a>
            <h2>{{trailname}}</h2>
        </div>
    </div>

    {{#hasrows}}
        <div class="table-responsive">
            <table class="table kopere-trail-table">
                <thead>
                    <tr>
                        <th>{{#str}}student, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}email{{/str}}</th>
                        <th>{{#str}}completed, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}percent, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}status, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}xp, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}lastupdate, local_kopere_trail{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <td><a href="{{userurl}}">{{student}}</a></td>
                            <td>{{email}}</td>
                            <td>{{completedsteps}} / {{totalsteps}}</td>
                            <td>
                                <div class="kopere-trail-progress kopere-trail-progress--small">
                                    <span style="width: {{percent}}%"></span>
                                </div>
                                {{percent}}%
                            </td>
                            <td>{{status}}</td>
                            <td>{{xp}}</td>
                            <td>{{lastupdate}}</td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}

    {{^hasrows}}
        <div class="kopere-trail-empty">
            <p>{{#str}}noreportrows, local_kopere_trail{{/str}}</p>
        </div>
    {{/hasrows}}
</div>

