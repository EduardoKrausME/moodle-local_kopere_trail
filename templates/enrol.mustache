{{!
    @template local_kopere_trail/enrol

    Example context (json):
    {}
}}

<div class="kopere-trail kopere-trail-enrol">
    <div class="kopere-trail__topbar">
        <div>
            <a class="kopere-trail-back" href="{{manageurl}}">{{#str}}backtomanage, local_kopere_trail{{/str}}</a>
            <h2>{{trailname}}</h2>
        </div>
    </div>

    {{#hasassignments}}
        <div class="table-responsive">
            <table class="table kopere-trail-table">
                <thead>
                    <tr>
                        <th>{{#str}}assignmenttype, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}assignmenttarget, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}status, local_kopere_trail{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#assignments}}
                        <tr>
                            <td>{{type}}</td>
                            <td>{{targetname}}</td>
                            <td>{{status}}</td>
                        </tr>
                    {{/assignments}}
                </tbody>
            </table>
        </div>
    {{/hasassignments}}

    {{^hasassignments}}
        <div class="kopere-trail-empty">
            <p>{{#str}}noassignments, local_kopere_trail{{/str}}</p>
        </div>
    {{/hasassignments}}
</div>
