{{!
    @template local_kopere_trail/index

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<div class="kopere-trail kopere-trail-index">
    <div class="kopere-trail__topbar">
        <div>
            <h2>{{#str}}myjourneys, local_kopere_trail{{/str}}</h2>
        </div>
        {{#canmanage}}
            <a class="btn btn-outline-primary" href="{{manageurl}}">{{#str}}gotomanage, local_kopere_trail{{/str}}</a>
        {{/canmanage}}
    </div>

    {{#hastrails}}
        <div class="kopere-trail-grid">
            {{#trails}}
                <article class="kopere-trail-card">
                    <div class="kopere-trail-card__header">
                        <h3><a href="{{url}}">{{name}}</a></h3>
                        <span class="kopere-trail-status">{{status}}</span>
                    </div>
                    <div class="kopere-trail-card__summary">{{{summary}}}</div>
                    <div class="kopere-trail-progress" aria-label="{{progressline}}">
                        <span style="width: {{percentrounded}}%"></span>
                    </div>
                    <p class="kopere-trail-muted">{{progressline}}</p>
                    <a class="btn btn-primary" href="{{url}}">{{#str}}view, local_kopere_trail{{/str}}</a>
                </article>
            {{/trails}}
        </div>
    {{/hastrails}}

    {{^hastrails}}
        <div class="kopere-trail-empty">
            <p>{{#str}}notrailenrolments, local_kopere_trail{{/str}}</p>
        </div>
    {{/hastrails}}
</div>

