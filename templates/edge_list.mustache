{{!
    @template local_kopere_trail/edge_list

    Example context (json):
    {}
}}

<div class="kopere-trail kopere-trail-edges-admin">
    <div class="kopere-trail__topbar">
        <div>
            <a class="kopere-trail-back" href="{{stepsurl}}">{{#str}}trailsteps, local_kopere_trail{{/str}}</a>
            <h2>{{trailname}}</h2>
        </div>
        <a class="btn btn-primary" href="{{createurl}}">{{#str}}createedge, local_kopere_trail{{/str}}</a>
    </div>

    {{#hasedges}}
        <div class="table-responsive">
            <table class="table kopere-trail-table">
                <thead>
                    <tr>
                        <th>{{#str}}fromstep, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}tostep, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}prereqtype, local_kopere_trail{{/str}}</th>
                        <th>{{#str}}actions, local_kopere_trail{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#edges}}
                        <tr>
                            <td>{{fromstep}}</td>
                            <td>{{tostep}}</td>
                            <td>{{ruleplugin}}</td>
                            <td class="kopere-trail-actions">
                                <a class="btn btn-sm btn-outline-secondary" href="{{moveupurl}}" title="{{#str}}moveup, local_kopere_trail{{/str}}">↑</a>
                                <a class="btn btn-sm btn-outline-secondary" href="{{movedownurl}}" title="{{#str}}movedown, local_kopere_trail{{/str}}">↓</a>
                                <a class="btn btn-sm btn-outline-primary" href="{{editurl}}">{{#str}}edit, local_kopere_trail{{/str}}</a>
                            </td>
                        </tr>
                    {{/edges}}
                </tbody>
            </table>
        </div>
    {{/hasedges}}

    {{^hasedges}}
        <div class="kopere-trail-empty">
            <p>{{#str}}noedges, local_kopere_trail{{/str}}</p>
        </div>
    {{/hasedges}}
</div>
